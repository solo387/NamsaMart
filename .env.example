NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:8080
POSTGRES_DB=namsamart
POSTGRES_USER=namsamart
POSTGRES_PASSWORD=change-this-local-database-password
DATABASE_URL=postgresql://namsamart:change-this-local-database-password@localhost:5432/namsamart?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
APP_URL=http://localhost:8080

# SMTP is required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NamsaMart <no-reply@example.com>

# Cloudinary is required for media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Daily.co is required for live class room creation and joining.
DAILY_API_KEY=

# Development seed account password (do not use outside local development).
SEED_PASSWORD=StudyNamsa!2026
